# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ---- 临时文件与日志 ----
/tmp/
*.log
*.tmp
*.bak

# ---- Rust 构建产物 ----
# 工作区单一 target/ 目录（根包与 gui/ 共用）
/target/
# 单文件二进制由 `cargo build --release` 重新生成；如需入库用 `git add -f`
/firebat-cc
/gui/firebat-cc-gui

# ---- 逆向参考素材（reference/windows） ----
# 厂商安装包与二进制体积大（主安装包约 177 MB），超过常见 Git 托管平台单文件限制
/reference/windows/**/*.exe
/reference/windows/**/*.msi
/reference/windows/**/*.msix
/reference/windows/**/*.msixbundle
/reference/windows/**/*.appx
/reference/windows/**/*.appxbundle
/reference/windows/**/*.appxsym
/reference/windows/**/*.cer
/reference/windows/**/*.p7x
/reference/windows/**/*.dll
/reference/windows/**/*.sys
/reference/windows/**/*.cat
/reference/windows/**/*.inf
/reference/windows/**/*.zip
/reference/windows/**/*.7z
/reference/windows/**/*.cab
/reference/windows/**/*.ico
/reference/windows/**/*.png
/reference/windows/**/*.jpg
/reference/windows/**/*.jpeg

# 解包/反编译产物（如本地生成）
/build/
/dist/
/decompiled/
/extracted/
/reference/windows/extracted/

# ---- WorkBuddy 会话数据与系统杂项 ----
/.workbuddy/
/.Trash-0/

# ---- 保留小型可读配置与说明 ----
!/reference/windows/TF_ControlCenter_5.49.51.44GX_Firebat/setup.ini
!/reference/windows/TF_ControlCenter_5.49.51.44GX_Firebat/RGBKeyboard.reg
!/reference/windows/TF_ControlCenter_5.49.51.44GX_Firebat/安装前必读.txt
